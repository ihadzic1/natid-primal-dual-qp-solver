#!/usr/bin/env bash
set -euo pipefail

readonly real_dpkg_deb="${NATIDQP_REAL_DPKG_DEB:-/usr/bin/dpkg-deb}"
readonly valid_package_name='natidqp-solver'
package_root=''

# For a build invocation such as `dpkg-deb --build ... natid_qp_gui`, locate
# the package tree generated by natID's SetupCollector. Read-only invocations
# and unrelated dpkg-deb calls are passed through unchanged.
for argument in "$@"; do
  if [ -d "$argument/DEBIAN" ] && [ -f "$argument/DEBIAN/control" ]; then
    package_root="$argument"
    break
  fi
done

if [ -n "$package_root" ]; then
  control_file="$package_root/DEBIAN/control"
  generated_package_name="$(sed -n \
    '/^Package:/{s/^Package:[[:space:]]*//;p;q;}' "$control_file")"

  if [[ ! "$generated_package_name" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
    echo "[natidqp] Correcting Debian Package field '$generated_package_name' to '$valid_package_name'."
    sed -i \
      "s/^Package:.*/Package: $valid_package_name/" \
      "$control_file"
  fi

  corrected_package_name="$(sed -n \
    '/^Package:/{s/^Package:[[:space:]]*//;p;q;}' "$control_file")"
  if [[ ! "$corrected_package_name" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
    echo "[natidqp] Invalid Debian Package field after correction: '$corrected_package_name'." >&2
    exit 2
  fi
fi

exec "$real_dpkg_deb" "$@"
