<?xml version="1.0"?>
<SetupCollector xmlns:win="windows" xmlns:mac="macOS" xmlns:lin="linux" executableName="natid_qp_gui">
    <Folders dev="~Desktop/NatIDQP-Packaging-Source/gui"
             executable="$RAMDisk/Out/NatIDQP/Release"
             out="$RAMDisk/Setup/NatIDQP"/>
    <Packages debug="false">
        <Package name="natGUIALL"/>
        <Package name="Matrix"/>
        <Package name="symbSolvers"/>
        <Package name="GTK4" exclude="macOS,linux"/>
    </Packages>
    <ResData>
        <Res type="folder"
             dev="$MyBin/GTK/release/share/glib-2.0/schemas"
             dep="schemas"
             exclude="macOS,linux"/>
    </ResData>
    <MutableResource/>
    <Setup licenseFileName="~natID.SDK/DevEnv/License.txt"
           categories="Education;Science;Utility"
           win:programGroup="NatIDQP"
           win:width="440"
           win:headerBackColor="#1E5AA8"
           win:headerTxtColor="#FFFFFF"
           win:licenseTxtColor="#404040"
           win:useMakeCabinet="true"
           win:minBuildNumber="17763"/>
</SetupCollector>
